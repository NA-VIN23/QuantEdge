# ==============================================================================
# QuantEdge — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# Miscellaneous editors
*.swp
*.swo
*.sw?
*~
*.bak

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# Python (FastAPI / Pandas / Pytest)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Jupyter & IPython
.ipynb_checkpoints/
*-checkpoint.ipynb
.ipython/

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vite / React / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.oxlint_cache/
.eslintcache
.parcel-cache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment overrides
*.local

# ------------------------------------------------------------------------------
# Market Data & Research Outputs
# ------------------------------------------------------------------------------
# Keep baseline ITC benchmark dataset for the out-of-the-box demo,
# but ignore all new/future raw stock downloads in Data/raw/stocks/
Data/raw/stocks/*
!Data/raw/stocks/README.md
!Data/raw/stocks/.gitkeep

# Ignore large binary/database formats, caches, and dumps
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.sqlite3
*.db

# Temporary research scratchpad & scratch directories
.scratch/
scratch/
temp/
tmp/
